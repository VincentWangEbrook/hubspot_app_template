# HTTP 80 端口：强制跳转 HTTPS
server {
    listen 80;
    server_name your-domain.com www.your-domain.com;  # 替换为你的域名
    return 301 https://$host$request_uri;
}

# HTTPS 443 端口：转发请求到 Next.js 和 NestJS
server {
    listen 443 ssl;
    server_name your-domain.com www.your-domain.com;

    # HTTPS 证书配置（路径对应 docker-compose 中挂载的 ./nginx/certs）
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # SSL 优化配置
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers "EECDH+AESGCM:EDH+AESGCM:AES256+EECDH:AES256+EDH";
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;

    # 1. 转发页面请求到 Next.js（SSR）
    location / {
        proxy_pass http://nextjs-ssr:3000;  # 对应 Next.js 服务名和容器内端口
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;  # 传递 HTTPS 协议标识
        proxy_cache_bypass $http_upgrade;
    }

    # 2. 转发 API 请求到 NestJS
    location /api {
        proxy_pass http://nestjs-api:3001;  # 对应 NestJS 服务名和容器内端口
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        # 可选：API 超时配置
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
    }

    # 3. 静态资源缓存（Next.js 构建后的静态文件）
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2|woff|ttf)$ {
        proxy_pass http://nextjs-ssr:3000;
        proxy_set_header Host $host;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        add_header ETag "";  # 禁用 ETag，依赖 Cache-Control
    }

    # Gzip 压缩优化
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 1k;
    gzip_comp_level 6;
}