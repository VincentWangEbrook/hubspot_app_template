# 根目录 .env.example（Monorepo 共享变量）
# 说明：此文件为模板，复制为 .env 后生效，请勿提交敏感信息

##########################
# 第三方服务配置（共享）
##########################
# HubSpot OAuth 基础配置（前后端共用）
# 获取地址：https://developers.hubspot.com/
HUBSPOT_CLIENT_ID=       # 应用客户端 ID
HUBSPOT_CLIENT_SECRET= # 应用客户端密钥
HUBSPOT_REDIRECT_URI= # 后端回调地址（需与 HubSpot 开发者平台配置一致）

##########################
# 服务地址配置（共享）
##########################
# 前端访问后端的基础地址（后端也可能用到，如生成前端跳转链接）
BACKEND_URL=
FRONTEND_URL= # 前端地址（后端回调/通知用）


# 全局环境
NODE_ENV=  # 环境：development/production/test

# PostgreSQL 配置
POSTGRES_USER=  # 数据库用户名（替换为自定义）
POSTGRES_PASSWORD=  # 强密码（生产环境务必修改）
POSTGRES_DB=
POSTGRES_PORT=  # 宿主机映射端口

# Redis 配置
REDIS_PASSWORD=  # 强密码（生产环境务必修改）
REDIS_DB=
REDIS_PORT=  # 宿主机映射端口

# NestJS 配置
NESTJS_PORT=  # 容器内端口（无需修改，Nginx 内部转发）
JWT_SECRET=  # JWT 密钥（生产环境务必随机生成）生产环境用 openssl rand -hex 32 生成
# 可选：其他 NestJS 环境变量（如第三方 API 密钥）
# HUBSPOT_API_KEY=your-hubspot-api-key
# EMAIL_SERVICE_KEY=your-email-service-key

# Next.js 配置
NEXTJS_PORT=  # 容器内端口（无需修改）

# Nginx 端口配置
HTTP_PORT=
HTTPS_PORT=

# 可选：域名配置（若 Nginx 需动态读取）
# DOMAIN=your-domain.com
# WWW_DOMAIN=www.your-domain.com