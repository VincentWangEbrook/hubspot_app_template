# 后端 .env
##########################
# 服务基础配置
##########################
# 环境标识：development/production/test
NODE_ENV=development
# NestJS 服务端口
PORT=3001

##########################
# 数据库配置
##########################
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=hubspot_app
# 可选：合并为连接字符串（部分工具支持）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hubspot_app

##########################
# 第三方服务动态配置（不硬编码敏感令牌）
##########################
# 注意：正式环境通过 OAuth 流程获取，此处仅为开发测试临时用
HUBSPOT_ACCESS_TOKEN=your-test-access-token
HUBSPOT_CLIENT_ID=b4437d0e-f00c-4cba-9119-1e67bf476147
HUBSPOT_CLIENT_SECRET=1f1cceff-27c7-4dec-ad79-c7bcd009c65a
HUBSPOT_OAUTH_REDIRECT_URI=http://localhost:3000/oauth-callback

##########################
# 日志与安全配置
##########################
# 日志级别：debug/info/warn/error
LOG_LEVEL=info
 # 可选：如果有用户认证，用于 JWT 签名
JWT_SECRET=your-jwt-secret-key