{
  "name": "hubspot-app-monorepo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:backend": "pnpm --filter api dev",
    "dev:frontend": "pnpm --filter web dev",
    "dev:shared": "pnpm --filter shared dev",
    "dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\" \"pnpm dev:shared\"",
    "build:shared": "pnpm --filter shared build"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}