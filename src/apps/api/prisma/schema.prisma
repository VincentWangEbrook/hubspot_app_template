generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------- Models -----------------

model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique @db.VarChar(255)
  password   String   @db.VarChar(255)
  username   String   @db.VarChar(100)
  role       String   @default("user") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  tenantMemberships   TenantMember[]
  createdTenants      Tenant[]              @relation("TenantCreator")
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Tenant {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String    @db.VarChar(255)
  hubspotId           String    @unique @map("hubspot_id") @db.VarChar(100)
  hubspotAccessToken  String?   @map("hubspot_access_token") @db.Text
  hubspotRefreshToken String?   @map("hubspot_refresh_token") @db.Text
  hubspotExpiresAt    Int?      @map("hubspot_expires_at")
  hubspotScope        Json?     @map("hubspot_scope")
  createdBy           String    @map("created_by") @db.Uuid
  raw                 Json?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  members TenantMember[]
  creator User           @relation("TenantCreator", fields: [createdBy], references: [id])

  @@map("tenants")
}

model TenantMember {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      String    @default("member") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("tenant_members")
}

model Channel {
  id               Int      @id @default(autoincrement())
  tenantId         String   @map("tenant_id") @db.Uuid
  channelType      String   @map("channel_type") @db.VarChar(50) // 'LINE', 'WECHAT', 'OTHER'
  externalUserId   String   @map("external_user_id") @db.VarChar(255)
  hubspotContactId String   @map("hubspot_contact_id") @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  messages             Message[]
  hubspotConversations HubspotConversation[]

  @@unique([tenantId, channelType, externalUserId])
  @@map("channels")
}

model Message {
  id          Int      @id @default(autoincrement())
  channelId   Int      @map("channel_id")
  tenantId    String   @map("tenant_id") @db.Uuid
  content     String   @db.Text
  isFromUser  Boolean  @map("is_from_user")
  createdAt   DateTime @default(now()) @map("created_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model HubspotConversation {
  id               Int      @id @default(autoincrement())
  tenantId         String   @map("tenant_id") @db.Uuid
  hubspotContactId String   @map("hubspot_contact_id") @db.VarChar(100)
  conversationId   String   @map("conversation_id") @db.VarChar(100)
  channelId        Int      @map("channel_id")
  createdAt        DateTime @default(now()) @map("created_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([tenantId, hubspotContactId, channelId])
  @@map("hubspot_conversations")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}
