// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Data model
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  username  String
  role      String   @default("user") // 'admin' | 'user'
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  tenantsOwned Tenant[] @relation("UserTenants")

  @@map("users")
}

model Tenant {
  id                  String    @id // uuid, provided manually
  name                String
  hubId               String?   @unique
  hubspotAccessToken  String?   @db.Text
  hubspotRefreshToken String?   @db.Text
  hubspotExpiresAt    DateTime?
  hubspotScope        String?   @db.Text
  createdBy           String?   // Just a string in TypeORM, separate from user relation
  raw                 Json?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  userId String? // TypeORM default for @ManyToOne
  user   User?   @relation("UserTenants", fields: [userId], references: [id])

  members TenantMember[]

  @@map("tenants")
}

model TenantMember {
  id       String @id @default(uuid())
  tenantId String @db.Uuid
  userId   String @db.Uuid
  role     String @default("member") // 'owner' | 'admin' | 'member'

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("tenant_members")
}

// --- Tenant Schema Models (Dynamic Context) ---
// These tables exist in 'tenant_UUID' schemas, but we define them here for client generation.
// At runtime, we switch search_path to access them.

model Channel {
  id               Int      @id @default(autoincrement())
  tenantId         String
  channelType      String   // 'LINE' | 'WECHAT' | 'OTHER'
  externalUserId   String
  hubspotContactId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  messages             Message[]
  hubspotConversations HubspotConversation[]

  @@unique([tenantId, channelType, externalUserId])
  @@map("channels")
}

model Message {
  id         Int      @id @default(autoincrement())
  channelId  Int      @map("channel_id")
  tenantId   String
  content    String   @db.Text
  isFromUser Boolean
  createdAt  DateTime @default(now())

  // Relations
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model HubspotConversation {
  id               Int      @id @default(autoincrement())
  tenantId         String
  hubspotContactId String
  conversationId   String
  channelId        Int      @map("channel_id")
  createdAt        DateTime @default(now())

  // Relations
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([tenantId, hubspotContactId, channelId])
  @@map("hubspot_conversations")
}
