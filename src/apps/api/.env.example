# ================================
# API 后端配置示例
# 复制此文件为 .env.development 或 .env.production
# ================================

# 服务端口
PORT=3001

# ============ 数据库 ============
DATABASE_URL=postgresql://username:password@localhost:5432/hubspot_app?schema=public

# ============ Redis (Session/缓存) ============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============ 安全密钥 ============
# Session 密钥 (至少32位随机字符串)
SESSION_SECRET=your-session-secret-at-least-32-characters

# JWT 密钥 (用于 token 签名)
JWT_SECRET=your-jwt-secret-key

# ============ SMTP 邮件服务 ============
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM_NAME=eTrunk 平台
SMTP_FROM_EMAIL=noreply@example.com

# ============ Stripe 支付 ============
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_TEST_PRICE_ID=price_xxx

# ============ LINE 渠道 ============
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# ============ HubSpot OAuth ============
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_OAUTH_REDIRECT_URI=http://localhost:3000/oauth-callback
