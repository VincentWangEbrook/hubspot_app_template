# 复制此文件为 .env 或 .env.development，替换占位符
# 数据库配置
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-strong-db-password  # 生产环境用强密码
POSTGRES_DB=hubspot_app
POSTGRES_PORT=5432

# Redis 配置
REDIS_PASSWORD=your-strong-redis-password
REDIS_DB=0
REDIS_PORT=6379
SESSION_SECRET=your-strong-session-secret

# NestJS 配置
NODE_ENV=development
NESTJS_PORT=3001
JWT_SECRET=your-random-jwt-secret-32bytes  # 生产用 openssl rand -hex 32 生成
LOG_LEVEL=info  # 日志级别：debug/info/warn/error

# 第三方 API 配置（示例）
HUBSPOT_API_KEY=your-hubspot-api-key  # 仅后端需要，前端不暴露

# Line 配置
LINE_CHANNEL_ACCESS_TOKEN=CHANNEL_ACCESS_TOKEN
LINE_CHANNEL_SECRET=CHANNEL_SECRET
LINE_WEBHOOK_PATH=/api/line/webhook