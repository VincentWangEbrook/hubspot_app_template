# 复制此文件为 .env 或 .env.development，替换占位符
NODE_ENV=development
NEXTJS_PORT=3000

# 前端请求后端 API 的基础路径（必须加 NEXT_PUBLIC_ 前缀，客户端可访问）
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/  # 本地开发
# NEXT_PUBLIC_API_BASE_URL=http://nestjs-api:3001/api  # 容器内通信（docker-compose 用）

# 前端专属公开配置（示例）
NEXT_PUBLIC_SITE_TITLE=HubSpot App  # 网站标题
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com  # 公开邮箱