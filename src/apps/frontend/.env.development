##########################
# 后端接口配置
##########################
# 复制此文件为 .env 或 .env.development，替换占位符
NODE_ENV=development
NEXTJS_PORT=3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001/api/

##########################
# 第三方服务前端配置
##########################
# HubSpot 应用 ID（前端嵌入表单/插件用）
NEXT_PUBLIC_HUBSPOT_APP_ID=your-hubspot-app-id
# 后端授权入口地址（前端跳转用）
NEXT_PUBLIC_HUBSPOT_AUTH_URL=${NEXT_PUBLIC_BACKEND_URL}auth/hubspot