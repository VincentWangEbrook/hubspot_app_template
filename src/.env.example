# 根目录 .env.example（Monorepo 共享变量）
# 说明：此文件为模板，复制为 .env 后生效，请勿提交敏感信息

##########################
# 第三方服务配置（共享）
##########################
# HubSpot OAuth 基础配置（前后端共用）
# 获取地址：https://developers.hubspot.com/
HUBSPOT_CLIENT_ID=your-hubspot-client-id       # 应用客户端 ID
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret # 应用客户端密钥
HUBSPOT_REDIRECT_URI=http://localhost:3001/api/auth/hubspot/callback # 后端回调地址（需与 HubSpot 开发者平台配置一致）

##########################
# 服务地址配置（共享）
##########################
# 前端访问后端的基础地址（后端也可能用到，如生成前端跳转链接）
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000 # 前端地址（后端回调/通知用）