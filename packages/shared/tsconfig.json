{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "moduleResolution": "Node",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "isolatedModules": true,
      "declaration": true, // 生成类型声明文件（.d.ts），关键！
      "declarationMap": true, // 类型映射（便于调试）
      "sourceMap": true, // 生成源映射文件
      "outDir": "dist", // 编译产物输出目录
      "rootDir": "src", // 源代码根目录
      "baseUrl": ".",
      "paths": {
        "@/*": ["src/*"] // 路径别名（方便内部导入）
      }
    },
    "include": ["src/**/*"], // 要编译的文件
    "exclude": ["node_modules", "dist", "**/*.test.ts"] // 排除文件
}