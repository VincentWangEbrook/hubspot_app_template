{
    "name": "shared",
    "version": "0.1.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      },
      "./utils/*": {
        "import": "./dist/utils/*.js",
        "require": "./dist/utils/*.cjs",
        "types": "./dist/utils/*.d.ts"
      }
    },
    "scripts": {
      "build": "tsc",
      "dev": "tsc --watch",
      "clean": "rm -rf dist"
    },
    "devDependencies": {
      "typescript": "^5.5.4",
      "@types/node": "^20.14.10"
    },
    "dependencies": {},
    "peerDependencies": {
      "react": "^18.3.1"
    },
    "engines": {
      "node": ">=18.x"
    }
}